# Copy to ~/apps/auto-crm-api/.env on the Lighthouse server and fill in. Never commit the real file.
# The API refuses to start in production while a secret is still a placeholder.
ENVIRONMENT=production

# With a domain (its DNS A record points at the server) Caddy gets a TLS certificate by itself:
#   API_DOMAIN=api.example.com
#   ALLOWED_HOSTS=["api.example.com","localhost"]
# Without a domain, serve plain HTTP on the server's public IP. Traffic is not encrypted, so
# switch to a domain before real users log in. Only the Vercel server calls the API, never browsers.
API_DOMAIN=:80
ALLOWED_HOSTS=["203.0.113.10","localhost"]

# --- Database (Neon) ---
# Pooled connection string (host contains "-pooler"). Paste it as Neon shows it.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Same string without "-pooler". Migrations use it.
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Auth ---
# Each: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
AUTOMATION_API_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS / links ---
CORS_ORIGINS=["https://crm.example.com"]
FRONTEND_URL=https://crm.example.com

# --- AI ---
DEEPSEEK_API_KEY=

# --- Object storage (Neon). Names match the Neon console. Leave S3_PUBLIC_URL unset. ---
AWS_ENDPOINT_URL_S3=https://BUCKET.storage.REGION.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=auto-crm
S3_CREATE_BUCKET=false

# --- Email (Brevo API) ---
BREVO_API_KEY=
# Must be a sender or domain verified in Brevo, on your own domain (not gmail.com).
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Auto CRM
