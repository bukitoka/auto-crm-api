# --- Database ---
# Host port for docker compose (change it if 5432 is already in use, and update DATABASE_URL).
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auto_crm

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Service key used by n8n (sent as the X-API-Key header)
AUTOMATION_API_KEY=change-me

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- AI (DeepSeek, OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Object storage (MinIO, S3-compatible) ---
# Host ports for docker compose. 9100/9101 avoid clashing with other local MinIO instances.
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# How the API reaches MinIO (host:port, no scheme)...
S3_ENDPOINT=localhost:9100
# ...and the base URL browsers use for image links (presigned URLs).
S3_PUBLIC_URL=http://localhost:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=auto-crm
S3_SECURE=false

# --- Email (SMTP; Mailpit in development, inbox at http://localhost:8026) ---
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM_EMAIL=no-reply@autocrm.local
MAIL_FROM_NAME=Auto CRM

# Used to build links in emails (e.g. password reset).
FRONTEND_URL=http://localhost:3000
