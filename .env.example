# --- Database ---
# Host port for docker compose (change it if 5432 is already in use, and update DATABASE_URL).
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auto_crm

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Service key used by n8n (sent as the X-API-Key header)
AUTOMATION_API_KEY=change-me

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- AI (DeepSeek, OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Object storage (MinIO locally, Neon object storage in production) ---
# Host ports for docker compose. 9100/9101 avoid clashing with other local MinIO instances.
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# How the API reaches MinIO (host:port, no scheme)...
S3_ENDPOINT=localhost:9100
# ...and the base URL browsers use for image links (presigned URLs).
S3_PUBLIC_URL=http://localhost:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=auto-crm
S3_SECURE=false

# --- Email ---
# Development: SMTP_HOST points at Mailpit (docker compose), which catches every email.
# Inbox: http://localhost:8025. Production: leave SMTP_HOST empty and use Brevo below.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025

# Brevo transactional email API (SDK), used when SMTP_HOST is empty. Create an API key (not an
# SMTP key) in Brevo under SMTP & API > API Keys. MAIL_FROM_EMAIL must be a sender or domain
# verified in Brevo (any address works with Mailpit).
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@autocrm.local
MAIL_FROM_NAME=Auto CRM

# Used to build links in emails (e.g. password reset).
FRONTEND_URL=http://localhost:3000
